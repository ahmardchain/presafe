# Copy to .env and fill in. Never commit .env. Used by spike/scripts and scripts/testnet.
# The web app has its own: web/.env.example.

# NEAR Intents 1Click (spike/scripts)
ONECLICK_API_BASE=https://1click.chaindefuser.com
# Optional. Leave empty to call 1Click without an API key (unauthenticated fee applies).
ONECLICK_JWT=
SPIKE_MAINNET_RPC_URL=https://free.rpc.fastnear.com

# scripts/testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
