# Public network config (safe to expose). Defaults are the live testnet deployment.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_PRESAFE_CONTRACT=presafe-app.testnet
NEXT_PUBLIC_USDC_CONTRACT=presafe-musdc.testnet
NEXT_PUBLIC_DEMO_BUSINESS=lagos-sound-fest.testnet

# Server-only (never NEXT_PUBLIC). The relayer pays gas for allowlisted calls.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
